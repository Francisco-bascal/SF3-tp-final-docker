# Copiar a .env y cambiar las contrasenas. No subir .env al repositorio.

# PostgreSQL (administrador)
POSTGRES_DB=mediclock
POSTGRES_USER=admin
POSTGRES_PASSWORD=cambiar_admin

# Rol usado por n8n (SELECT + INSERT)
N8N_DB_USER=n8n_user
N8N_DB_PASSWORD=cambiar_n8n

# Rol usado por la aplicacion web (solo SELECT)
APP_DB_USER=app_user
APP_DB_PASSWORD=cambiar_app

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@mediclock.com
PGADMIN_DEFAULT_PASSWORD=cambiar_pgadmin

# Proxy inverso
PROXY_PUERTO=8080
