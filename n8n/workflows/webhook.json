{
  "id": "wfWebhookEventos1",
  "name": "Webhook - Registrar evento (HTTP)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "eventos",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-entrada",
      "name": "Webhook POST /eventos",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        200
      ],
      "webhookId": "a1b2c3d4-eventos-mediclock"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const entrada = $json.body && typeof $json.body === 'object' ? $json.body : {};\nconst datos = entrada;\nconst errores = [];\nconst TIPOS = ['dispensado', 'omitido', 'alarma', 'error'];\n\nconst textoValido = (valor, max) => typeof valor === 'string' && valor.trim() !== '' && valor.length <= max;\n\nif (!textoValido(datos.dispositivo, 50)) errores.push('dispositivo es obligatorio (texto de hasta 50 caracteres)');\nif (!TIPOS.includes(datos.tipo_evento)) errores.push('tipo_evento debe ser uno de: ' + TIPOS.join(', '));\nif (datos.detalle !== undefined && datos.detalle !== null && (typeof datos.detalle !== 'string' || datos.detalle.length > 200)) errores.push('detalle debe ser texto de hasta 200 caracteres');\nconst cantidad = datos.cantidad === undefined ? 1 : datos.cantidad;\nif (!Number.isInteger(cantidad) || cantidad <= 0) errores.push('cantidad debe ser un entero mayor a 0');\n\nreturn {\n  json: {\n    valido: errores.length === 0,\n    errores,\n    dispositivo: datos.dispositivo,\n    tipo_evento: datos.tipo_evento,\n    detalle: datos.detalle ?? null,\n    cantidad,\n  },\n};"
      },
      "id": "webhook-validar",
      "name": "Validar datos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condicion-valido",
              "leftValue": "={{ $json.valido }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "webhook-si",
      "name": "¿Datos válidos?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        200
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO eventos_dispensador (dispositivo, tipo_evento, detalle, cantidad) VALUES ($1, $2, $3, $4) RETURNING id;",
        "options": {
          "queryReplacement": "={{ [$('Validar datos').item.json.dispositivo, $('Validar datos').item.json.tipo_evento, $('Validar datos').item.json.detalle, $('Validar datos').item.json.cantidad] }}"
        }
      },
      "id": "webhook-pg",
      "name": "Insertar en PostgreSQL",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        720,
        100
      ],
      "credentials": {
        "postgres": {
          "id": "cred-postgres-n8n",
          "name": "Postgres MediClock (n8n_user)"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true, result: { id: $json.id, status: 'created' } } }}",
        "options": {
          "responseCode": 201
        }
      },
      "id": "webhook-ok",
      "name": "Responder 201",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        960,
        100
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: false, errors: $json.errores } }}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "webhook-error",
      "name": "Responder 400",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        720,
        320
      ]
    }
  ],
  "connections": {
    "Webhook POST /eventos": {
      "main": [
        [
          {
            "node": "Validar datos",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validar datos": {
      "main": [
        [
          {
            "node": "¿Datos válidos?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "¿Datos válidos?": {
      "main": [
        [
          {
            "node": "Insertar en PostgreSQL",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Responder 400",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Insertar en PostgreSQL": {
      "main": [
        [
          {
            "node": "Responder 201",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": true
}
